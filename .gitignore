# =============== #
# Unity .gitignore
# =============== #

# OS junk
.DS_Store
Thumbs.db

# User-specific files
*.user
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.userprefs
*.pidb
*.booproj
*.svd

# Unity generated folders
Library/
Temp/
Obj/
Build/
Builds/
Logs/
MemoryCaptures/

# Asset meta data should only be ignored when the corresponding asset is also ignored
# *.meta

# Autogenerated Jetbrains Rider plugin
.idea/
*.iml

# Visual Studio cache
.vs/

# Crash reports
sysinfo.txt

# Unity build outputs
*.apk
*.aab
*.unitypackage
*.app
*.xcodeproj/
*.xcworkspace/
*.xcuserdata/
DerivedData/

# Addressables
/ServerData/

# Lightmaps
LightmapSnapshot/

# Cache
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/

# Other
*.stackdump
